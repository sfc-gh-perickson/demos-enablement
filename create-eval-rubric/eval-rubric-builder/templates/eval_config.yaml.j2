# Cortex Agent evaluation config generated by eval-rubric-builder (compatible with agent-pareto-lab).
# All metrics score 0-1: built-ins report normalized_score in [0, 1]; custom judges use the same bands.
evaluation:
  agent_params:
    agent_name: "{{ agent }}"
    agent_type: "CORTEX AGENT"
    agent_version: "{{ agent_version }}"
  run_params:
    label: "{{ customer }} eval {{ dataset_version_label }}"
    description: "eval-rubric-builder: Tier A + frozen Tier B metrics"
  source_metadata:
    type: "dataset"
    dataset_name: "{{ dataset_name }}"

metrics:
{%- for m in builtins %}
  - name: "{{ m }}"
    version: "{{ scoring.builtin_version }}"
{%- endfor %}
{%- for m in custom %}
  - name: "{{ m.name }}"
    model: "{{ judge_model }}"
    score_ranges:
      min_score: {{ scoring.score_ranges.min_score }}
      median_score: {{ scoring.score_ranges.median_score }}
      max_score: {{ scoring.score_ranges.max_score }}
    prompt: |
{{ m.prompt | indent(6, first=True) }}
{%- endfor %}
